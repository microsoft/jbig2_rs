{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "standard_interface_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "review_kind", "package", "manifest", "source",
        "manifest_sha256", "source_sha256", "target", "requires", "ensures",
        "native_runtime_dependency", "normative_approval", "decision_reference", "review"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "review_kind": {"const": "delegated_engineering_review"},
        "package": {"const": "jbig2_capacity_interface"},
        "manifest": {"const": "verification/stdlib/vec-capacity-interface/Cargo.toml"},
        "source": {"const": "verification/stdlib/vec-capacity-interface/lib.rs"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "target": {"const": "std::vec::Vec<T, A>::capacity"},
        "requires": {"const": []},
        "ensures": {"const": []},
        "native_runtime_dependency": {"const": false},
        "normative_approval": {"const": false},
        "decision_reference": {"type": "string", "pattern": "^https://github\\.com/microsoft/jbig2_rs/issues/116#issuecomment-[0-9]+$"},
        "review": {"type": "string", "minLength": 100}
      }
    },
    "conformance_differences": {
      "type": "object", "required": ["schema_version", "cases"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "cases": {
          "type": "array", "items": {
            "type": "object", "required": ["id", "classification", "rationale"],
            "additionalProperties": false,
            "properties": {
              "id": {"$ref": "#/$defs/nonempty"},
              "classification": {"enum": ["reviewed_strict_rejection", "unsupported_profile", "pending_normative_review"]},
              "rationale": {"$ref": "#/$defs/nonempty"},
              "expected_error_contains": {"$ref": "#/$defs/nonempty"},
              "expected_error_exact": {"$ref": "#/$defs/nonempty"},
              "stream_sha256": {"$ref": "#/$defs/sha256"},
              "jbig2dec_stderr_sha256": {"$ref": "#/$defs/sha256"},
              "source_files_sha256": {
                "type": "object", "minProperties": 1, "additionalProperties": false,
                "patternProperties": {"^src/(?:[a-z_]+/)*[a-z_]+\\.rs$": {"$ref": "#/$defs/sha256"}}
              }
            },
            "if": {"properties": {"classification": {"enum": ["pending_normative_review", "reviewed_strict_rejection"]}}},
            "then": {
              "required": ["expected_error_exact", "stream_sha256", "source_files_sha256"],
              "properties": {"expected_error_contains": false}
            },
            "else": {
              "required": ["expected_error_contains"],
              "properties": {"expected_error_exact": false, "stream_sha256": false, "source_files_sha256": false}
            }
          }
        }
      }
    },
    "traceability_test": {
      "type": "object", "required": ["target", "name"],
      "additionalProperties": false,
      "properties": {
        "target": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "name": {"$ref": "#/$defs/nonempty"}
      }
    },
    "test_catalog": {
      "allOf": [{"$ref": "#/$defs/versioned"}],
      "required": ["cases"], "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "cases": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "tests"], "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^(NEG|META)-[A-Z0-9-]+$"},
              "surface": {"$ref": "#/$defs/nonempty"},
              "expected": {"$ref": "#/$defs/nonempty"},
              "transformation": {"$ref": "#/$defs/nonempty"},
              "invariant": {"$ref": "#/$defs/nonempty"},
              "tests": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"$ref": "#/$defs/traceability_test"}
              }
            },
            "oneOf": [
              {
                "required": ["surface", "expected"],
                "properties": {"id": {"pattern": "^NEG-"}, "transformation": false, "invariant": false}
              },
              {
                "required": ["transformation", "invariant"],
                "properties": {"id": {"pattern": "^META-"}, "surface": false, "expected": false}
              }
            ]
          }
        }
      }
    },
    "traceability_claim": {
      "type": "object", "required": ["runtime", "section", "tokens"],
      "properties": {
        "runtime": {"$ref": "#/$defs/nonempty"},
        "section": {"enum": ["ensures", "requires"]},
        "tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}
      }
    },
    "traceability": {
      "allOf": [{"$ref": "#/$defs/versioned"}],
      "required": ["review_policy", "standards", "source_consultations", "features", "definitions", "bindings", "requirements"],
      "properties": {
        "review_policy": {"$ref": "#/$defs/nonempty"},
        "release_scope": {
          "type": "object", "additionalProperties": false,
          "required": [
            "profile", "crate_version", "authority", "approved_at", "instruction",
            "decision_reference", "deferred_work", "exhaustive_requirement_coverage_required",
            "complete_functional_proof_required", "existing_proof_and_quality_gates_required",
            "full_spec_conformance_claim", "scope"
          ],
          "properties": {
            "profile": {"const": "0.1-partial-verus"},
            "crate_version": {"const": "0.1.1"},
            "authority": {"const": "repository_owner_release_scope"},
            "approved_at": {"$ref": "#/$defs/nonempty"},
            "instruction": {"$ref": "#/$defs/nonempty"},
            "decision_reference": {
              "type": "string",
              "pattern": "^https://github\\.com/microsoft/jbig2_rs/issues/125#issuecomment-[0-9]+$"
            },
            "deferred_work": {
              "type": "string",
              "pattern": "^https://github\\.com/microsoft/jbig2_rs/issues/[0-9]+$"
            },
            "exhaustive_requirement_coverage_required": {"const": false},
            "complete_functional_proof_required": {"const": false},
            "existing_proof_and_quality_gates_required": {"const": true},
            "full_spec_conformance_claim": {"const": false},
            "scope": {"$ref": "#/$defs/nonempty"}
          }
        },
        "maintenance_release_scope": {"$ref": "#/$defs/traceability/properties/release_scope"},
        "development_scope": {
          "type": "object", "additionalProperties": false,
          "required": ["profile", "crate_version", "maintenance_branch", "proof_completion_issue", "publication_enabled"],
          "oneOf": [
            {"properties": {"profile": {"const": "0.2-development"}, "crate_version": {"const": "0.2.0-dev"}, "maintenance_branch": {"const": "release/0.1"}}},
            {"properties": {"profile": {"const": "0.3-development"}, "crate_version": {"const": "0.3.0-dev"}, "maintenance_branch": {"const": "release/0.2"}}}
          ],
          "properties": {
            "profile": {"enum": ["0.2-development", "0.3-development"]},
            "crate_version": {"enum": ["0.2.0-dev", "0.3.0-dev"]},
            "maintenance_branch": {"enum": ["release/0.1", "release/0.2"]},
            "proof_completion_issue": {"const": "https://github.com/microsoft/jbig2_rs/issues/135"},
            "publication_enabled": {"const": false}
          }
        },
        "publication_scope": {
          "type": "object", "additionalProperties": false,
          "required": [
            "profile", "crate_version", "release_branch", "authority", "approved_at", "instruction",
            "decision_reference", "exhaustive_requirement_coverage_required", "complete_functional_proof_required",
            "existing_proof_and_quality_gates_required", "full_spec_conformance_claim"
          ],
          "properties": {
            "profile": {"const": "0.2-partial-verus"},
            "crate_version": {"const": "0.2.0"},
            "release_branch": {"const": "release/0.2"},
            "authority": {"const": "repository_owner_release_scope"},
            "approved_at": {"$ref": "#/$defs/nonempty"},
            "instruction": {"$ref": "#/$defs/nonempty"},
            "decision_reference": {"type": "string", "pattern": "^agent-host-session://ahp-session/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
            "exhaustive_requirement_coverage_required": {"const": false},
            "complete_functional_proof_required": {"const": false},
            "existing_proof_and_quality_gates_required": {"const": true},
            "full_spec_conformance_claim": {"const": false}
          }
        },
        "historical_owner_review_confirmation": {"$ref": "#/$defs/traceability/properties/owner_review_confirmation"},
        "owner_review_confirmation": {
          "type": "object", "additionalProperties": false,
          "required": [
            "authority", "confirmed_at", "instruction", "decision_reference",
            "source_revision", "project_source_sha256", "requirements_sha256",
            "normative_model_review_validated", "exhaustive_requirement_coverage",
            "complete_functional_proof", "independent_certificate", "scope"
          ],
          "properties": {
            "authority": {"const": "repository_owner_confirmation"},
            "confirmed_at": {"$ref": "#/$defs/nonempty"},
            "instruction": {"$ref": "#/$defs/nonempty"},
            "decision_reference": {
              "type": "string",
              "pattern": "^https://github\\.com/microsoft/jbig2_rs/issues/125#issuecomment-[0-9]+$"
            },
            "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "project_source_sha256": {"$ref": "#/$defs/sha256"},
            "requirements_sha256": {"$ref": "#/$defs/sha256"},
            "normative_model_review_validated": {"const": true},
            "exhaustive_requirement_coverage": {"const": false},
            "complete_functional_proof": {"const": false},
            "independent_certificate": {"const": false},
            "scope": {"$ref": "#/$defs/nonempty"}
          }
        },
        "standards": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "edition", "document_sha256"],
            "properties": {
              "id": {"$ref": "#/$defs/nonempty"},
              "edition": {"anyOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]},
              "provenance_collection": {"enum": ["normative_documents", "normative_references"]},
              "document_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "source_consultations": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["standard", "acquisition_kind", "acquisition_url", "document_sha256", "clause_families"],
            "allOf": [{
              "if": {"properties": {"acquisition_kind": {"const": "official_package"}}},
              "then": {"required": ["package_sha256"]},
              "else": {"not": {"required": ["package_sha256"]}}
            }],
            "properties": {
              "standard": {"$ref": "#/$defs/nonempty"},
              "acquisition_kind": {"enum": ["official_package", "official_pdf"]},
              "acquisition_url": {"type": "string", "pattern": "^https://www\\.itu\\.int/rec/dologin_pub\\.asp\\?"},
              "package_sha256": {"$ref": "#/$defs/sha256"},
              "document_sha256": {"$ref": "#/$defs/sha256"},
              "clause_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}
            }
          }
        },
        "features": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["feature", "support_status", "decomposition", "requirement_ids", "remaining_scope"],
            "properties": {
              "feature": {"$ref": "#/$defs/nonempty"},
              "support_status": {"enum": ["required", "unsupported", "deferred", "prohibited"]},
              "decomposition": {"enum": ["not_started", "partial", "complete", "excluded"]},
              "requirement_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T(?:88|6)-[A-Z0-9-]+$"}},
              "remaining_scope": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}
            }
          }
        },
        "definitions": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object", "required": ["kind", "file", "module_path", "name", "role"],
            "properties": {
              "kind": {"enum": ["spec", "proof", "macro"]},
              "file": {"type": "string", "pattern": "^(specs|proofs)/.+\\.rs$"},
              "module_path": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
              "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "role": {"$ref": "#/$defs/nonempty"}
            }
          }
        },
        "bindings": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "requirements": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "standard", "clause", "title", "feature", "runtime", "models", "proof_macros", "tests", "strength", "review", "scope_of_formal_result", "assumptions", "gaps", "functional_evidence", "invariant_evidence"],
            "allOf": [{
              "if": {"required": ["obligation_kind"], "properties": {"obligation_kind": {"const": "project_profile_policy"}}},
              "then": {"required": ["policy_row_sha256"]},
              "else": {"not": {"anyOf": [{"required": ["policy_row_sha256"]}, {"required": ["policy_source"]}]}}
            }],
            "properties": {
              "id": {"type": "string", "pattern": "^T(?:88|6)-[A-Z0-9-]+$"},
              "standard": {"$ref": "#/$defs/nonempty"},
              "clause": {"$ref": "#/$defs/nonempty"}, "title": {"$ref": "#/$defs/nonempty"},
              "feature": {"$ref": "#/$defs/nonempty"},
              "obligation_kind": {"enum": ["normative_rule", "project_profile_policy"]},
              "policy_row_sha256": {"$ref": "#/$defs/sha256"},
              "policy_source": {"enum": ["feature_row", "public_api"]},
              "runtime": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
              "models": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
              "proof_macros": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
              "tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/traceability_test"}},
              "strength": {"enum": ["functional_contract", "state_preservation", "safety_only", "runtime_divergence"]},
              "review": {"enum": ["provisional", "approved"]},
              "scope_of_formal_result": {"$ref": "#/$defs/nonempty"},
              "assumptions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
              "gaps": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}},
              "functional_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/traceability_claim"}},
              "invariant_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/traceability_claim"}}
            }
          }
        }
      }
    },
    "coverage_fraction": {
      "type": "object", "required": ["count", "covered"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "covered": {"type": "integer", "minimum": 0}
      }
    },
    "coverage_metrics": {
      "type": "object", "required": ["lines", "regions", "branches"],
      "properties": {
        "lines": {"$ref": "#/$defs/coverage_fraction"},
        "regions": {"$ref": "#/$defs/coverage_fraction"},
        "branches": {"$ref": "#/$defs/coverage_fraction"}
      }
    },
    "coverage_baseline": {
      "allOf": [{"$ref": "#/$defs/versioned"}],
      "required": ["scope_version", "source_revision", "source_sha256", "toolchain", "release_goals", "totals", "files", "policy"],
      "properties": {
        "scope_version": {"const": 1},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "test_source_sha256": {"$ref": "#/$defs/sha256"},
        "policy": {"$ref": "#/$defs/nonempty"},
        "toolchain": {
          "type": "object", "required": ["rust_toolchain", "cargo_llvm_cov_version", "component"]
        },
        "release_goals": {
          "type": "object", "required": ["lines", "branches"], "additionalProperties": false,
          "properties": {
            "lines": {"type": "number", "minimum": 0, "maximum": 100},
            "branches": {"type": "number", "minimum": 0, "maximum": 100}
          }
        },
        "totals": {"$ref": "#/$defs/coverage_metrics"},
        "files": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/coverage_metrics"}
        }
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "pattern": "\\S"},
    "versioned": {
      "type": "object", "required": ["schema_version"],
      "properties": {"schema_version": {"const": 1}}
    },
    "repository": {
      "allOf": [{"$ref": "#/$defs/versioned"}],
      "properties": {
        "status": {"$ref": "#/$defs/nonempty"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "production_source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "unresolved_failures": {"type": "integer", "minimum": 0},
        "redistribution": {"type": "boolean"},
        "cases": {
          "type": "array", "items": {
            "type": "object", "required": ["id"],
            "properties": {"id": {"$ref": "#/$defs/nonempty"}}
          }
        },
        "scenarios": {
          "type": "array", "items": {
            "type": "object", "required": ["id"],
            "properties": {"id": {"$ref": "#/$defs/nonempty"}}
          }
        },
        "files": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["path", "sha256", "size_bytes", "kind"],
            "properties": {
              "path": {"$ref": "#/$defs/nonempty"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "size_bytes": {"type": "integer", "minimum": 0},
              "kind": {"enum": ["encoded_stream", "expected_bitmap"]}
            }
          }
        },
        "rows": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["feature", "status", "clauses"],
            "properties": {
              "feature": {"$ref": "#/$defs/nonempty"},
              "status": {"enum": ["required", "deferred", "unsupported", "prohibited"]},
              "clauses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}
            }
          }
        },
        "policy": {
          "type": ["object", "string"],
          "properties": {
            "standards_text_committed": {"const": false},
            "non_redistributable_assets_committed": {"const": false},
            "third_party_uploads_permitted": {"const": false}
          }
        }
      }
    },
    "function": {
      "type": "object", "required": ["id", "file", "file_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "file": {"type": "string", "pattern": "^src/.+\\.rs$"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dispositions": {
      "allOf": [{"$ref": "#/$defs/versioned"}],
      "required": ["policy", "functions"],
      "properties": {
        "policy": {"$ref": "#/$defs/nonempty"},
        "functions": {
          "type": "array",
          "items": {
            "allOf": [{"$ref": "#/$defs/function"}],
            "required": ["status", "reason"],
            "properties": {
              "status": {"enum": ["reviewed-verifier-limitation", "audited-forwarder", "runtime-proof-divergence"]},
              "reason": {"$ref": "#/$defs/nonempty"}
            }
          }
        }
      }
    },
    "coverage": {
      "allOf": [{"$ref": "#/$defs/versioned"}],
      "required": ["source", "verus_verified_obligations", "native_assumptions", "counts", "functions"],
      "properties": {
        "verus_verified_obligations": {"type": "integer", "minimum": 1},
        "native_assumptions": {"const": []},
        "counts": {
          "type": "object",
          "required": ["verified", "incomplete", "audited-forwarder", "reviewed-verifier-limitation", "native-assumption"],
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "functions": {
          "type": "array", "minItems": 1,
          "items": {
            "allOf": [{"$ref": "#/$defs/function"}],
            "required": ["status", "visibility", "disposition_reason", "verus_functions"],
            "properties": {
              "status": {"enum": ["verified", "incomplete", "reviewed-verifier-limitation", "audited-forwarder", "runtime-proof-divergence"]},
              "visibility": {"$ref": "#/$defs/nonempty"},
              "disposition_reason": {"type": ["string", "null"]},
              "verus_functions": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "verus": {
      "type": "object", "required": ["verification-results", "func-details"],
      "properties": {
        "verification-results": {
          "type": "object",
          "required": ["success", "errors", "verified", "is-verifying-entire-crate"],
          "properties": {
            "success": {"const": true}, "errors": {"const": 0},
            "verified": {"type": "integer", "minimum": 1},
            "is-verifying-entire-crate": {"const": true}
          }
        },
        "func-details": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object", "required": ["failed_proof_notes"],
            "properties": {"failed_proof_notes": {"const": []}}
          }
        }
      }
    },
    "proof_attestation": {
      "allOf": [{"$ref": "#/$defs/versioned"}],
      "required": ["source_revision", "result", "production_proof_coverage_sha256", "proof_dispositions_sha256", "release_gate"],
      "properties": {
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "production_proof_coverage_sha256": {"$ref": "#/$defs/sha256"},
        "proof_dispositions_sha256": {"$ref": "#/$defs/sha256"},
        "release_gate": {"type": "string"},
        "standard_library_boundary": {
          "type": "object", "additionalProperties": false,
          "required": ["manifest", "manifest_sha256", "interfaces", "review_kind", "normative_approval"],
          "properties": {
            "manifest": {"const": "verification/stdlib/review.json"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "interfaces": {"const": 1},
            "review_kind": {"const": "delegated_engineering_review"},
            "normative_approval": {"const": false}
          }
        },
        "result": {
          "type": "object",
          "required": ["verified_obligations", "verified_production_functions", "reviewed_verifier_limitations", "audited_forwarders", "incomplete_functions", "algorithm_bodies_verified", "native_assumptions"],
          "properties": {
            "verified_obligations": {"type": "integer", "minimum": 1},
            "verified_production_functions": {"type": "integer", "minimum": 0},
            "reviewed_verifier_limitations": {"type": "integer", "minimum": 0},
            "audited_forwarders": {"type": "integer", "minimum": 0},
            "incomplete_functions": {"type": "integer", "minimum": 0},
            "runtime_proof_divergences": {"type": "integer", "minimum": 0},
            "algorithm_bodies_verified": {"type": "boolean"},
            "native_assumptions": {"const": []}
          }
        }
      }
    },
    "toolchain": {
      "allOf": [{"$ref": "#/$defs/versioned"}],
