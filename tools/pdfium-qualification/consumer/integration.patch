diff --git a/core/fxcodec/jbig2/jbig2_decoder_unittest.cpp b/core/fxcodec/jbig2/jbig2_decoder_unittest.cpp
new file mode 100644
index 000000000..df51d77d9
--- /dev/null
+++ b/core/fxcodec/jbig2/jbig2_decoder_unittest.cpp
@@ -0,0 +1,70 @@
+// Copyright 2026 The PDFium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "core/fxcodec/jbig2/jbig2_decoder.h"
+
+#include <array>
+
+#include "core/fxcodec/jbig2/jbig2_document_context.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace fxcodec {
+namespace {
+
+// An embedded 9x2 page with black as its default pixel and no regions.
+constexpr uint8_t kStream[] = {
+    0, 0, 0, 1, 48, 0, 1, 0, 0, 0, 19,  // Page information header.
+    0, 0, 0, 9, 0,  0, 0, 2,            // Width and height.
+    0, 0, 0, 0, 0,  0, 0, 0,            // Resolution.
+    4, 0, 0,                            // Flags and striping.
+    0, 0, 0, 2, 49, 0, 1, 0, 0, 0, 0,   // End of page.
+};
+
+TEST(Jbig2DecoderTest, DecodesEmbeddedPageWithPitchedRows) {
+  Jbig2Context context;
+  JBig2_DocumentContext document;
+  alignas(uint32_t) std::array<uint8_t, 9> dest = {};
+  dest.back() = 0x5a;
+
+  EXPECT_EQ(FXCODEC_STATUS::kDecodeFinished,
+            Jbig2Decoder::StartDecode(&context, &document, 9, 2, kStream, 0, {},
+                                      0, dest, 4, nullptr, false));
+  EXPECT_EQ(0, dest[0]);
+  EXPECT_EQ(0, dest[1] & 0x80);
+  EXPECT_EQ(0, dest[4]);
+  EXPECT_EQ(0, dest[5] & 0x80);
+  EXPECT_EQ(0x5a, dest.back());
+}
+
+TEST(Jbig2DecoderTest, ClipsToSmallerCanvas) {
+  Jbig2Context context;
+  JBig2_DocumentContext document;
+  alignas(uint32_t) std::array<uint8_t, 5> dest = {};
+  dest.back() = 0x5a;
+
+  ASSERT_EQ(FXCODEC_STATUS::kDecodeFinished,
+            Jbig2Decoder::StartDecode(&context, &document, 5, 1, kStream, 0, {},
+                                      0, dest, 4, nullptr, false));
+  EXPECT_EQ(0, dest[0] & 0xf8);
+  EXPECT_EQ(0x5a, dest.back());
+}
+
+#if defined(PDF_ENABLE_RUST_JBIG2)
+TEST(Jbig2DecoderTest, FillsUncoveredCanvasPixelsAndPadding) {
+  Jbig2Context context;
+  JBig2_DocumentContext document;
+  alignas(uint32_t) std::array<uint8_t, 12> dest = {};
+
+  ASSERT_EQ(FXCODEC_STATUS::kDecodeFinished,
+            Jbig2Decoder::StartDecode(&context, &document, 10, 3, kStream, 0,
+                                      {}, 0, dest, 4, nullptr, false));
+  constexpr std::array<uint8_t, 12> kExpected = {
+      0, 0x7f, 0xff, 0xff, 0, 0x7f, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+  };
+  EXPECT_EQ(kExpected, dest);
+}
+#endif
+
+}  // namespace
+}  // namespace fxcodec
diff --git a/core/fxcodec/jbig2/rust_jbig2_ffi.rs b/core/fxcodec/jbig2/rust_jbig2_ffi.rs
new file mode 100644
index 000000000..8206137fa
--- /dev/null
+++ b/core/fxcodec/jbig2/rust_jbig2_ffi.rs
@@ -0,0 +1,114 @@
+// Copyright 2026 The PDFium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+use jbig2_decoder::{Decoder, Limits};
+
+#[cxx::bridge(namespace = "fxcodec::rust_jbig2")]
+mod ffi {
+    extern "Rust" {
+        fn decode(
+            src: &[u8],
+            globals: &[u8],
+            width: u32,
+            height: u32,
+            pitch: usize,
+            dest: &mut [u8],
+            reject_large_regions_when_fuzzing: bool,
+        ) -> bool;
+    }
+}
+
+fn decode(
+    src: &[u8],
+    globals: &[u8],
+    width: u32,
+    height: u32,
+    pitch: usize,
+    dest: &mut [u8],
+    reject_large_regions_when_fuzzing: bool,
+) -> bool {
+    let row_bytes = (width as usize).div_ceil(8);
+    if width == 0
+        || height == 0
+        || pitch < row_bytes
+        || pitch.checked_mul(height as usize) != Some(dest.len())
+    {
+        return false;
+    }
+
+    let mut limits = Limits::default();
+    limits.max_pages = 1;
+    if reject_large_regions_when_fuzzing {
+        limits.max_width = 4096;
+        limits.max_height = 4096;
+        limits.max_pixels_per_page = 4096 * 4096;
+    }
+    let decoder = Decoder::new(limits);
+    let mut context = decoder.context();
+    #[cfg(not(pdf_eval_jbig2_best_effort))]
+    let result = if globals.is_empty() {
+        context.decode_embedded(src)
+    } else {
+        context
+            .parse_globals(globals)
+            .and_then(|globals| context.decode_embedded_with_globals(src, &globals))
+    };
+    #[cfg(pdf_eval_jbig2_best_effort)]
+    let result = (|| {
+        let parsed = if globals.is_empty() {
+            None
+        } else {
+            Some(context.parse_globals(globals)?)
+        };
+        context
+            .decode_embedded_with_policy(
+                src,
+                parsed.as_ref(),
+                jbig2_decoder::EmbeddedPolicy::BestEffort,
+            )
+            .map(|decoded| {
+                static DIAGNOSTICS: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+                if *DIAGNOSTICS.get_or_init(|| std::env::var_os("JBIG2_EVAL_RECOVERIES").is_some()) {
+                    for recovery in &decoded.recoveries {
+                        eprintln!("JBIG2_RECOVERY {recovery:?}");
+                    }
+                }
+                decoded.value
+            })
+    })();
+    let document = match result {
+        Ok(document) => document,
+        Err(error) => {
+            eprintln!("JBIG2_ERROR {error:?}");
+            return false;
+        }
+    };
+    let [page] = document.pages() else {
+        return false;
+    };
+    let bitmap = page.bitmap();
+    let copy_width = width.min(bitmap.width()) as usize;
+    let copy_height = height.min(bitmap.height()) as usize;
+    if copy_width == 0 || copy_height == 0 {
+        return false;
+    }
+    let copy_bytes = copy_width.div_ceil(8);
+
+    // Clip to the PDF canvas and leave uncovered pixels and padding white.
+    // JBIG2 stores black as 1; PDFium expects black as 0.
+    dest.fill(0xff);
+    for (out, input) in dest
+        .chunks_exact_mut(pitch)
+        .take(copy_height)
+        .zip(bitmap.bytes().chunks_exact(bitmap.stride()))
+    {
+        for (out_byte, input_byte) in out[..copy_bytes].iter_mut().zip(input) {
+            *out_byte = !input_byte;
+        }
+        if copy_width % 8 != 0 {
+            out[copy_bytes - 1] |= (1 << (8 - copy_width % 8)) - 1;
+        }
+    }
+    true
+}
