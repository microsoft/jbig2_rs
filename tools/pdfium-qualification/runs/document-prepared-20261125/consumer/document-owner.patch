+#if defined(PDF_ENABLE_RUST_JBIG2)
+bool JBig2_DocumentContext::DecodeRust(pdfium::span<const uint8_t> src,
+                                       uint64_t src_key,
+                                       pdfium::span<const uint8_t> globals,
+                                       uint64_t global_key,
+                                       uint32_t width,
+                                       uint32_t height,
+                                       uint32_t pitch,
+                                       pdfium::span<uint8_t> dest,
+                                       bool reject_large) {
+  const char* bypass = nullptr;
+  if (!width || !height || pitch < (uint64_t{width} + 7) / 8 ||
+      uint64_t{height} * pitch != dest.size()) {
+    bypass = "invalid_canvas";
+  } else if (bridge::is_best_effort()) {
+    bypass = "best_effort_policy";
+  } else if (!OwnerMode()) {
+    bypass = "disabled";
+  } else if (globals.empty()) {
+    bypass = "no_globals";
+  } else if (StorageOption("JBIG2_DOC_BUDGET", 4 * 1024 * 1024) <
+             sizeof(Jbig2RustDocumentOwner)) {
+    bypass = "document_metadata_budget";
+  } else {
+    if (!rust_owner_) {
+      rust_owner_ = std::make_unique<Jbig2RustDocumentOwner>();
+    }
+    if (globals.size() > rust_owner_->budget()) {
+      bypass = "encoded_global_budget";
+    } else if (!rust_owner_->Matches(globals, reject_large)) {
+      bypass = "document_slot_or_limits";
+    } else {
+      return rust_owner_->Decode(src, src_key, globals, width, height, pitch,
+                                 dest, reject_large);
+    }
+  }
+  if (OwnerTrace()) {
+    std::fprintf(stderr,
+                 "JBIG2_OWNER_BYPASS reason=%s source_key=%llu global_key=%llu "
+                 "retained=%llu\n",
+                 bypass, static_cast<unsigned long long>(src_key),
+                 static_cast<unsigned long long>(global_key),
+                 static_cast<unsigned long long>(
+                     rust_owner_ ? rust_owner_->RetainedBytes() : 0));
+  }
+  return bridge::decode(
+      rust::Slice<const uint8_t>(src.data(), src.size()),
+      rust::Slice<const uint8_t>(globals.data(), globals.size()), width, height,
+      pitch, rust::Slice<uint8_t>(dest.data(), dest.size()), reject_large);
+}
+
+void JBig2_DocumentContext::ResetRustForTesting() {
+  if (rust_owner_) {
+    rust_owner_->Reset();
+  }
+}
