+      current = temporary.get();
+      current->metadata = sizeof(*this) + sizeof(Entry) +
+                          current->key.capacity() +
+                          bridge::parsed_storage(*current->parsed) +
+                          bridge::prepared_box_bytes();
+      if (current->metadata <= budget_ &&
+          bridge::parsed_valid(*current->parsed)) {
+        current->prepared.emplace(bridge::new_prepared(
+            *current->parsed,
+            std::min(allowance_, budget_ - current->metadata)));
+        entry_ = std::move(temporary);
+      }
+    }
+    if (!current->prepared) {
+      if (OwnerTrace()) {
+        std::fprintf(
+            stderr,
+            "JBIG2_OWNER_BYPASS reason=%s owner=%p source_key=%llu "
+            "metadata=%llu budget=%llu retained=%zu\n",
+            bridge::parsed_valid(*current->parsed) ? "aggregate_metadata_budget"
+                                                   : "global_parse_error",
+            static_cast<void*>(this), static_cast<unsigned long long>(src_key),
+            static_cast<unsigned long long>(current->metadata),
+            static_cast<unsigned long long>(budget_), sizeof(*this));
+      }
+      return bridge::decode_parsed(*current->parsed, source, width, height,
+                                   pitch, output);
+    }
+    auto before = bridge::owner_info(**current->prepared);
+    bool success = OwnerMode() == 2
+                       ? bridge::decode_prepared(**current->prepared, source,
+                                                 width, height, pitch, output)
+                       : bridge::decode_parsed(*current->parsed, source, width,
+                                               height, pitch, output);
+    auto after = bridge::owner_info(**current->prepared);
+    CHECK(current->metadata <= budget_);
+    CHECK(after.resident <= budget_ - current->metadata);
+    if (OwnerTrace()) {
+      std::fprintf(
+          stderr,
+          "JBIG2_OWNER owner=%p source_key=%llu mode=%d parsed_hit=%d "
+          "resource_hit=%d success=%d before=%u after=%u resident=%llu "
+          "metadata=%llu reserved=%llu budget=%llu\n",
+          static_cast<void*>(this), static_cast<unsigned long long>(src_key),
+          OwnerMode(), parsed_hit,
+          success && before.state == 1 && after.state == 1, success,
+          before.state, after.state,
+          static_cast<unsigned long long>(after.resident),
+          static_cast<unsigned long long>(current->metadata),
+          static_cast<unsigned long long>(current->metadata + after.allowance),
+          static_cast<unsigned long long>(budget_));
+    }
+    return success;
+  }
+
+  bool Matches(pdfium::span<const uint8_t> globals, bool reject_large) const {
+    return !entry_ || (entry_->reject_large == reject_large &&
+                       std::ranges::equal(entry_->key, globals));
+  }
+
+  uint64_t budget() const { return budget_; }
+
+  uint64_t RetainedBytes() const {
+    return entry_ ? entry_->metadata +
+                        bridge::owner_info(**entry_->prepared).resident
+                  : sizeof(*this);
+  }
+
+  void Reset() {
+    if (entry_) {
+      bridge::owner_reset(**entry_->prepared);
+      CHECK(bridge::owner_info(**entry_->prepared).resident == 0);
+    }
+  }
+
+ private:
+  const uint64_t budget_ = StorageOption("JBIG2_DOC_BUDGET", 4 * 1024 * 1024);
+  const uint64_t allowance_ = StorageOption("JBIG2_DOC_ALLOWANCE", 65536);
+  std::unique_ptr<Entry> entry_;
+};
